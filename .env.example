# Asatru PHP - App environment configuration file
# 
# Scheme:
#   name=value
# Example
#   APP_NAME="My App name"
# Datatypes:
#   string, integer, float, boolean and null (auto detected)

# App settings
APP_NAME="SayText Chat"
APP_VERSION=1.0
APP_AUTHOR="Daniel Brendel"
APP_CONTACT="daniel@danielbrendel.com"
APP_DEBUG=true
APP_BASEDIR=""
APP_TIMEZONE=null
APP_SERVERNAME="${APP_NAME} Testserver"
APP_SERVERTOPIC="Welcome to this ${APP_SERVERNAME}"
APP_SERVERPREVIEW="preview.png"
APP_DELAY_FETCH=10000
APP_DELAY_ONLINE=10000
APP_RESOURCEHOST=""
APP_SERVERLISTHOST=""

# Session
SESSION_ENABLE=true
SESSION_DURATION=0
SESSION_NAME=null

# Database settings
DB_ENABLE=false
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD=""
DB_PORT=3306
DB_DATABASE="asatru"
DB_DRIVER=mysql
DB_CHARSET="utf8"

# SMTP settings
SMTP_FROMNAME="Test"
SMTP_FROMADDRESS="test@domain.tld"
SMTP_HOST=""
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_ENCRYPTION=tls

# Logging
LOG_ENABLE=true